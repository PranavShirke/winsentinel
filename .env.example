# WinSentinel Environment Configuration
# Copy this file to .env and customize the values for your environment.

# Flask Application Secret Key (required for sessions and CSRF protection)
# Generate a strong key e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=winsentinel-default-change-in-production-key-secret

# National Vulnerability Database (NVD) API Key (Optional)
# If provided, increases the rate limit from ~5 req/30s to ~50 req/30s.
# Request an API key at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# SQLite Database Location (defaults to winsentinel.db in the project root)
DATABASE_PATH=winsentinel.db

# Flask Debug Mode (Must always remain False in production / security context)
DEBUG=False

# Analysis Window in days for Windows Security Event Log scanning
ANALYSIS_WINDOW_DAYS=7
